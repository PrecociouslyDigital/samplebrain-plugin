From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sydney <sydney@hyphen-emdash.com>
Date: Tue, 24 Nov 2026 20:04:37 -0800
Subject: [PATCH 4/6] Tell callers when the renderer finishes a pass

The renderer quietly started again from the beginning when it ran off the
end of the target. completed_pass() now says when that happened, and
process() returns whether it wrote anything, so a caller can render a
target exactly once.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 brain/src/renderer.cpp | 12 +++++++++---
 brain/src/renderer.h   |  7 ++++++-
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/brain/src/renderer.cpp b/brain/src/renderer.cpp
index 1d1d8f7..823f0d1 100644
--- a/brain/src/renderer.cpp
+++ b/brain/src/renderer.cpp
@@ -35,6 +35,7 @@ void renderer::init() {
   m_stretch=1;
   m_last_tgt_shift=0;
   m_autotune=0;
+  m_completed_pass=false;
 }
 
 static int ratio_time = 0;
@@ -49,7 +50,9 @@ void renderer::reset() {
 }
 
 
-void renderer::process(u32 nframes, float *buf, const block_stream *bs) {
+bool renderer::process(u32 nframes, float *buf, const block_stream *bs) {
+  m_completed_pass=false;
+
   // we can get blocks from the preprocessed target brain
   // or the realtime block stream
   const block_source *source = (block_source*)bs;
@@ -66,8 +69,8 @@ void renderer::process(u32 nframes, float *buf, const block_stream *bs) {
     }
   }
 
-  if (!m_playing) return;
-  if (!find_render_blocks(*source,nframes)) return;
+  if (!m_playing) return false;
+  if (!find_render_blocks(*source,nframes)) return false;
 
   render(*source,nframes,buf);
 
@@ -75,6 +78,7 @@ void renderer::process(u32 nframes, float *buf, const block_stream *bs) {
 
   m_render_time+=nframes;
   //m_target_time+=nframes/(float)m_stretch;
+  return true;
 }
 
 // target_time = samples time into target stream
@@ -95,6 +99,8 @@ bool renderer::find_render_blocks(const block_source &target, u32 nframes) {
   if (tgt_shift!=m_last_tgt_shift ||
       tgt_end>=target.get_num_blocks() ||
       m_source.get_num_blocks()==0) {
+    // the first call always lands here, because the shift starts at 0
+    m_completed_pass = tgt_shift==m_last_tgt_shift;
     reset();
     m_last_tgt_shift = tgt_shift;
     // next time...
diff --git a/brain/src/renderer.h b/brain/src/renderer.h
index 01c6103..cf23fcf 100644
--- a/brain/src/renderer.h
+++ b/brain/src/renderer.h
@@ -45,7 +45,11 @@ namespace spiralcore {
     void reset();
 
     // block stream should be NULL if we are reading the target brain instead
-    void process(u32 nframes, float *buf, const block_stream *bs=NULL);
+    // returns false if nothing was written to buf
+    bool process(u32 nframes, float *buf, const block_stream *bs=NULL);
+    // whether the last process ran off the end of the target and started
+    // again from the beginning
+    bool completed_pass() const { return m_completed_pass; }
 
     void set_search_algo(search_algo s) { m_search_algo=s; }
     void set_playing(bool s) { m_playing=s; }
@@ -113,6 +117,7 @@ namespace spiralcore {
     search_algo m_search_algo;
     double m_slide_error;
     u32 m_last_tgt_shift;
+    bool m_completed_pass;
 
     std::list<render_block> m_render_blocks;
   };
