+#include <random>
+#include <vector>
+#include "spiralcore/types.h"
+
+#pragma once
+
+namespace spiralcore {
+
+// Everything a search changes as it runs. Each renderer owns one, so
+// several renderers can search the same brain at once.
+class search_state {
+public:
+  search_state(u32 num_blocks, std::vector<bool> sound_enabled,
+               float usage_falloff, u32 seed) :
+    m_usage(num_blocks, 0),
+    m_sound_enabled(std::move(sound_enabled)),
+    m_usage_falloff(usage_falloff),
+    m_rng(seed) {}
+
+  // one per brain block
+  std::vector<float> m_usage;
+  // one per brain sound
+  std::vector<bool> m_sound_enabled;
+  float m_usage_falloff;
+  u32 m_current_block_index = 0;
+  double m_current_error = 0;
+  std::mt19937 m_rng;
+};
+
+}
