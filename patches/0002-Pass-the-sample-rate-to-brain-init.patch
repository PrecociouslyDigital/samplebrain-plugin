From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sydney <sydney@hyphen-emdash.com>
Date: Tue, 24 Nov 2026 20:04:13 -0800
Subject: [PATCH 2/7] Pass the sample rate to brain::init

brain::chop_and_add built every block at 44100, whatever the rate of the
sound. The rate is now an argument to brain::init. Blocks already stored
and saved their rate.

The FFT and MFCC analysers were static members shared by every block, and
init_fft only rebuilt them when the block size changed, not the rate. It
also only deleted the old ones when they were null. Each thread now keeps
its own analysers and rebuilds them when the size or the rate changes.

FFTW's planner isn't thread safe, so plan creation and destruction take a
lock. FFT's destructor also frees the spectrum and bins it was leaking.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 brain/src/block.cpp    | 25 ++++++++++++++++---------
 brain/src/block.h      |  3 +--
 brain/src/brain.cpp    | 18 +++++++++---------
 brain/src/brain.h      |  4 ++--
 brain/src/fft.cpp      | 12 +++++++++++-
 brain/src/renderer.cpp |  6 +++---
 6 files changed, 42 insertions(+), 26 deletions(-)

diff --git a/brain/src/block.cpp b/brain/src/block.cpp
index 1fb1a4e..e20431d 100644
--- a/brain/src/block.cpp
+++ b/brain/src/block.cpp
@@ -17,13 +17,21 @@
 #include <assert.h>
 #include <float.h>
 #include <iostream>
+#include <memory>
 
 #include "block.h"
 
 using namespace spiralcore;
 
-FFT *block::m_fftw;
-Aquila::Mfcc *block::m_mfcc_proc;
+// Each thread keeps its own analysers, so blocks can be built on several
+// threads at once.
+namespace {
+  struct analysers {
+    std::unique_ptr<FFT> fft;
+    std::unique_ptr<Aquila::Mfcc> mfcc;
+  };
+  thread_local analysers t_analysers;
+}
 
 static const int MFCC_FILTERS=12;
 static const int FFT_BIAS=200;
@@ -77,8 +85,6 @@ block::block(u64 id, const string &filename, const sample &pcm, u32 rate, const
   m_orig_filename(filename)
 {
   init_fft(m_pcm.get_length(),rate);
-  assert(m_mfcc_proc!=NULL);
-  assert(m_fftw!=NULL);
 
   w.run(m_pcm);
   process(m_pcm,m_fft,m_mfcc,m_dominant_freq);
@@ -97,15 +103,16 @@ block::block(u64 id, const string &filename, const sample &pcm, u32 rate, const
 
 
 void block::init_fft(u32 block_size, u32 rate) {
-  if (m_fftw == NULL || m_fftw->m_length!=block_size) {
-    if (m_fftw == NULL) delete m_fftw;
-    m_fftw = new FFT(block_size,rate,100);
-    if (m_mfcc_proc == NULL) delete m_mfcc_proc;
-    m_mfcc_proc = new Aquila::Mfcc(block_size,rate);
+  analysers &a = t_analysers;
+  if (!a.fft || a.fft->m_length!=block_size || a.fft->m_rate!=rate) {
+    a.fft = std::make_unique<FFT>(block_size,rate,100);
+    a.mfcc = std::make_unique<Aquila::Mfcc>(block_size,rate);
   }
 }
 
 void block::process(const sample &pcm, sample &fft, sample &mfcc, float &freq) {
+  FFT *m_fftw = t_analysers.fft.get();
+  Aquila::Mfcc *m_mfcc_proc = t_analysers.mfcc.get();
   m_fftw->impulse2freq(pcm.get_buffer());
   m_fftw->calculate_bins();
 
